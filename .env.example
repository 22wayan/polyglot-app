# Optional. Only needed if you self-host with one server-side key.
# Users can instead enter their own key in the Setup tab.
# Server side (Vercel project settings). Never prefix the key with VITE_.
ANTHROPIC_API_KEY=

# Optional shared token. Set the same value on the server and at build time;
# requests without it are rejected. It ends up in the JS bundle, so it filters
# drive-by traffic and is not a real secret.
VITE_APP_TOKEN=
